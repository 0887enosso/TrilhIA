# Supabase — Configurações > Database > Connection string
# DATABASE_URL usa o connection pooler (porta 6543, pgbouncer=true) — usada em runtime.
# DIRECT_URL usa a conexão direta (porta 5432) — usada só pelo Prisma Migrate.
DATABASE_URL="postgresql://postgres:[SENHA]@[PROJETO].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[SENHA]@[PROJETO].supabase.co:5432/postgres"

# Segredo usado para assinar os tokens de sessão (JWT). Gere um valor aleatório
# forte antes de subir para produção — nunca reutilize o valor de exemplo.
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio-forte"

# Protege a rota /api/cron/semanal contra chamadas externas não autorizadas.
# Ao configurar essa variável no projeto Vercel, a própria Vercel passa a
# enviar automaticamente esse valor no header Authorization das chamadas de
# cron — não é preciso nenhuma configuração adicional além de definir o valor.
CRON_SECRET="troque-este-valor-por-outro-segredo-aleatorio-forte"
